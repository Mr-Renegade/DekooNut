#version 450
// DLSS's image into the game's upscale target. The game's upscaler squares its coded colour on the way out (the
// linear target), so this does too. A larger DLSS image (3840x2160 into the 1706x960 target) is box-filtered: every
// source texel weighted by the part of it the target pixel's footprint covers.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D dlss_color;
layout(binding = 1, r11f_g11f_b10f) uniform writeonly image2D guest_color;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(guest_color);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }
    ivec2 size = textureSize(dlss_color, 0);
    vec3 sampled;
    if (all(equal(size, extent))) {
        sampled = texelFetch(dlss_color, pixel, 0).rgb;
    } else if (all(greaterThan(size, extent))) {
        vec2 scale = vec2(size) / vec2(extent);
        vec2 lo = vec2(pixel) * scale, hi = lo + scale;
        ivec2 a = ivec2(floor(lo)), b = min(ivec2(ceil(hi)), size) - 1;
        vec3 sum = vec3(0.0);
        float total = 0.0;
        for (int y = a.y; y <= b.y; y++) {
            float wy = min(hi.y, float(y + 1)) - max(lo.y, float(y));
            for (int x = a.x; x <= b.x; x++) {
                float w = wy * (min(hi.x, float(x + 1)) - max(lo.x, float(x)));
                sum += w * max(texelFetch(dlss_color, ivec2(x, y), 0).rgb, vec3(0.0));
                total += w;
            }
        }
        sampled = sum / max(total, 1e-6);
    } else {
        sampled = textureLod(dlss_color, (vec2(pixel) + 0.5) / vec2(extent), 0).rgb;
    }
    vec3 color = max(sampled, vec3(0.0));
    imageStore(guest_color, pixel, vec4(color * color, 1.0));
}
