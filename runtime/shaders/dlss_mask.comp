#version 450
// DLSS's BiasCurrentColor mask (1 = trust the current colour), the larger of two tests (params.mode bits 0 and 1) that find
// what moves on its own, since the motion vectors are the camera's only. DLSS mask: see docs/how-it-works.md, "DLSS bias mask".
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D scene_depth;
layout(binding = 1, r8) uniform writeonly image2D mask;
layout(binding = 2) uniform sampler2D previous_depth;
layout(binding = 3) uniform sampler2D current_color;
layout(binding = 4) uniform sampler2D previous_color;

layout(push_constant, row_major) uniform Parameters {
    mat4 clip_to_previous_clip;
    float threshold;
    float color_threshold;
    uint mode;
} params;

vec3 previous_bilinear(vec2 at, ivec2 extent) {   // at: previous-frame pixel coordinates (centres at +0.5)
    vec2 p = at - 0.5;
    ivec2 i = ivec2(floor(p));
    vec2 f = p - vec2(i);
    ivec2 hi = extent - 1;
    vec3 a = texelFetch(previous_color, clamp(i, ivec2(0), hi), 0).rgb;
    vec3 b = texelFetch(previous_color, clamp(i + ivec2(1, 0), ivec2(0), hi), 0).rgb;
    vec3 c = texelFetch(previous_color, clamp(i + ivec2(0, 1), ivec2(0), hi), 0).rgb;
    vec3 d = texelFetch(previous_color, clamp(i + ivec2(1, 1), ivec2(0), hi), 0).rgb;
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(mask);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }
    vec2 size = vec2(extent);
    float depth = texelFetch(scene_depth, pixel, 0).r;
    vec2 ndc = (vec2(pixel) + 0.5) / size * vec2(2, -2) + vec2(-1, 1);
    vec4 p1 = params.clip_to_previous_clip * vec4(ndc, depth * 2 - 1, 1);
    float bias = 0.0;
    if (p1.w > 1e-6) {
        vec2 previous = (p1.xy / p1.w) * vec2(0.5, -0.5) + 0.5;
        bool inside = all(greaterThanEqual(previous, vec2(0))) && all(lessThan(previous, vec2(1)));
        if ((params.mode & 1u) != 0u && inside && depth > 0.0 && depth < 1.0) {   // not the sky / cleared depth
            float e = depth < 0.5 ? 1e-3 : -1e-3;
            vec4 p2 = params.clip_to_previous_clip * vec4(ndc, (depth + e) * 2 - 1, 1);
            float z1 = p1.z / p1.w, z2 = p2.z / p2.w, inv = 1.0 / p1.w - 1.0 / p2.w;
            if (p2.w > 1e-6 && abs(inv) > 1e-12) {
                float b = (z1 - z2) / inv;
                float zs = texelFetch(previous_depth, ivec2(previous * size), 0).r * 2 - 1;
                if (abs(p1.w * (zs - z1) / b) > params.threshold) {
                    bias = 1.0;
                }
            }
        }
        if ((params.mode & 2u) != 0u && inside) {
            vec3 lo = vec3(1e9), hi = vec3(-1e9);
            for (int y = -1; y <= 1; y++) {
                for (int x = -1; x <= 1; x++) {
                    vec3 c = texelFetch(current_color, clamp(pixel + ivec2(x, y), ivec2(0), extent - 1), 0).rgb;
                    lo = min(lo, c);
                    hi = max(hi, c);
                }
            }
            vec3 h = previous_bilinear(previous * size, extent);
            vec3 out_of_box = max(lo - h, h - hi);
            float d = max(max(out_of_box.r, out_of_box.g), out_of_box.b);
            bias = max(bias, smoothstep(params.color_threshold, 3.0 * params.color_threshold, d));
        }
    }
    imageStore(mask, pixel, vec4(bias));
}
