#version 450
// The window image in place of FSR, after Lichii 65e979ad ocarina_dlss_4k_composite.comp (GPL-3.0).
// scene: DLSS's 3840x2160 image (sqrt-coded, squared to linear); reference: the game's upscale target after DLSS's image was
// box-filtered into it; native: the game's finished frame within its crop rectangle. native minus reference is what the game
// drew over the scene (HUD, fades, post effects); it is added to the scene, and where the difference exceeds hi the game frame
// is used. Both game samples use one Catmull-Rom filter so they line up. flags bit 0: the game frame is sRGB-coded (UNORM),
// so the scene and reference are coded the same way; bit 1: tint where the game frame is used (debug).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D dlss_scene;
layout(binding = 1, rgba16f) uniform writeonly image2D output_color;
layout(binding = 2) uniform sampler2D reference;
layout(binding = 3) uniform sampler2D native_frame;
layout(push_constant) uniform Controls {
    vec4 native_rect;   // the crop rectangle in the game frame's texture coordinates: offset, size
    float lo, hi;       // coverage ramp of the difference
    uint flags;
} pc;

vec3 encode_srgb(vec3 linear) {
    linear = clamp(linear, vec3(0.0), vec3(1.0));
    return mix(1.055 * pow(linear, vec3(1.0 / 2.4)) - 0.055, 12.92 * linear, lessThan(linear, vec3(0.0031308)));
}

// Catmull-Rom from 9 bilinear taps (the weights of the outer taps are negative, the inner pair is one tap).
vec3 catmull_rom(sampler2D t, vec2 uv) {
    vec2 size = vec2(textureSize(t, 0));
    vec2 sp = uv * size;
    vec2 t1 = floor(sp - 0.5) + 0.5;
    vec2 f = sp - t1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 p0 = (t1 - 1.0) / size, p3 = (t1 + 2.0) / size, p12 = (t1 + w2 / w12) / size;
    vec3 r = vec3(0.0);
    r += textureLod(t, vec2(p0.x, p0.y), 0).rgb * w0.x * w0.y;
    r += textureLod(t, vec2(p12.x, p0.y), 0).rgb * w12.x * w0.y;
    r += textureLod(t, vec2(p3.x, p0.y), 0).rgb * w3.x * w0.y;
    r += textureLod(t, vec2(p0.x, p12.y), 0).rgb * w0.x * w12.y;
    r += textureLod(t, vec2(p12.x, p12.y), 0).rgb * w12.x * w12.y;
    r += textureLod(t, vec2(p3.x, p12.y), 0).rgb * w3.x * w12.y;
    r += textureLod(t, vec2(p0.x, p3.y), 0).rgb * w0.x * w3.y;
    r += textureLod(t, vec2(p12.x, p3.y), 0).rgb * w12.x * w3.y;
    r += textureLod(t, vec2(p3.x, p3.y), 0).rgb * w3.x * w3.y;
    return r;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(output_color);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    bool coded = (pc.flags & 1u) != 0u;
    vec3 native = catmull_rom(native_frame, pc.native_rect.xy + uv * pc.native_rect.zw);
    vec3 ref = max(catmull_rom(reference, uv), vec3(0.0));
    // When DLSS's image is smaller than the window, the same Catmull-Rom scales it.
    vec3 s = max(all(equal(textureSize(dlss_scene, 0), extent)) ? texelFetch(dlss_scene, pixel, 0).rgb
                                                                 : catmull_rom(dlss_scene, uv), vec3(0.0));
    vec3 scene = s * s;
    if (coded) {
        ref = encode_srgb(ref);
        scene = encode_srgb(scene);
    }
    vec3 overlay = native - ref;
    float difference = max(max(abs(overlay.r), abs(overlay.g)), abs(overlay.b));
    float coverage = smoothstep(pc.lo, pc.hi, difference);
    vec3 color = mix(scene + overlay, native, coverage);
    if ((pc.flags & 2u) != 0u) {
        color = mix(color, vec3(1.0, 0.0, 0.0), 0.5 * coverage);
    }
    imageStore(output_color, pixel, vec4(clamp(color, 0.0, 1.0), 1.0));
}
