<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded by window.rc. Without a requestedExecutionLevel Windows takes a program whose name holds "setup" for an
     installer and refuses to start it from a process that is not elevated (error 740). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
