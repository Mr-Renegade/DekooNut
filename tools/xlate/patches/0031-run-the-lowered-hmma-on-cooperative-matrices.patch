+namespace Ryujinx.Graphics.Shader.Translation
+{
+    // OoT (2026-11-06): true while translating a program that holds the lowered HMMA marker (InstEmit.Mma). The three
+    // fixes below came with that path from ocarina-of-time-recomp and stay limited to it, so every other shader keeps
+    // the SPIR-V it had; they are general fixes and could be opened to all programs once that has been tested.
+    static class TensorProgram
+    {
+        [ThreadStatic]
+        public static bool Active;
+    }
+}
