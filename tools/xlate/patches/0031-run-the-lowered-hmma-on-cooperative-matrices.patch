+        // The lowered HMMA.16816.F16 (InstEmit.Mma): sources A0-A3, B0-B1, C0-C1, each a pair of halves; the result is the
+        // two words of D. The subgroup matrices' per-invocation element order on the device was measured to be the
+        // fragment layout the registers use, except that A's elements come in register order 0, 2, 1, 3
+        // (oot.exe --probe-coopmat), so no data moves between invocations: the elements go in and out with
+        // OpCompositeInsert / OpCompositeExtract.
+        private static OperationResult GenerateMatrixMultiplyAdd(CodeGenContext context, AstOperation operation)
+        {
+            context.UseCooperativeMatrixKhr();
+
+            SpvInstruction u32 = context.TypeU32();
+            SpvInstruction f16 = context.TypeFloat(16);
+            SpvInstruction v2f16 = context.TypeVector(f16, 2);
+            SpvInstruction scope = context.Constant(u32, (int)Scope.Subgroup);
+            SpvInstruction c16 = context.Constant(u32, 16);
+            SpvInstruction c8 = context.Constant(u32, 8);
+            SpvInstruction typeA = context.TypeCooperativeMatrixKHR(f16, scope, c16, c16, context.Constant(u32, 0));
+            SpvInstruction typeB = context.TypeCooperativeMatrixKHR(f16, scope, c16, c8, context.Constant(u32, 1));
+            SpvInstruction typeC = context.TypeCooperativeMatrixKHR(f16, scope, c16, c8, context.Constant(u32, 2));
+
+            SpvInstruction[] halves = new SpvInstruction[8];
+
+            for (int i = 0; i < 8; i++)
+            {
+                halves[i] = context.Bitcast(v2f16, context.GetU32(operation.GetSource(i)));
+            }
+
+            SpvInstruction Fill(SpvInstruction type, int count, int first, int[] order)
+            {
+                SpvInstruction m = context.Undef(type);
+
+                for (int e = 0; e < count; e++)
+                {
+                    int reg = first + (order != null ? order[e / 2] : e / 2);
+                    SpvInstruction h = context.CompositeExtract(f16, halves[reg], e & 1);
+                    m = context.CompositeInsert(type, h, m, e);
+                }
+
+                return m;
+            }
+
+            SpvInstruction a = Fill(typeA, 8, 0, [0, 2, 1, 3]);
+            SpvInstruction b = Fill(typeB, 4, 4, null);
+            SpvInstruction c = Fill(typeC, 4, 6, null);
+            SpvInstruction d = context.CooperativeMatrixMulAddKHR(typeC, a, b, c);
+
+            SpvInstruction[] words = new SpvInstruction[2];
+
+            for (int w = 0; w < 2; w++)
+            {
+                SpvInstruction lo = context.CompositeExtract(f16, d, 2 * w);
+                SpvInstruction hi = context.CompositeExtract(f16, d, 2 * w + 1);
+                words[w] = context.Bitcast(u32, context.CompositeConstruct(v2f16, lo, hi));
+            }
+
+            SpvInstruction result = context.CompositeConstruct(context.TypeVector(u32, 2), words[0], words[1]);
+
+            return new OperationResult(AggregateType.U32 | AggregateType.Vector2, result);
+        }
+
