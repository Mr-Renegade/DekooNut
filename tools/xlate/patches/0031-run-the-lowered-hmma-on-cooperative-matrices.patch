+        // The lowering's marker for SM86 HMMA.16816.F16 (InstTable): D[2] = A[4] x B[2] + C[2] over the subgroup, each
+        // register a pair of halves in the tensor cores' fragment layout. One operation with two results; the SPIR-V
+        // back end makes it a cooperative matrix multiply-add (CodeGen/Spirv/Instructions.cs GenerateMatrixMultiplyAdd).
+        public static void Mma(EmitterContext context)
+        {
+            Translation.TensorProgram.Active = true;
+
+            ulong op = context.CurrOp.RawOpCode;
+            int rd = (int)(op & 0xff), ra = (int)((op >> 8) & 0xff), rb = (int)((op >> 20) & 0xff), rc = (int)((op >> 39) & 0xff);
+
+            Operand[] sources = new Operand[8];
+
+            for (int i = 0; i < 4; i++)
+            {
+                sources[i] = GetSrcReg(context, ra == RegisterConsts.RegisterZeroIndex ? ra : ra + i);
+            }
+
+            for (int i = 0; i < 2; i++)
+            {
+                sources[4 + i] = GetSrcReg(context, rb == RegisterConsts.RegisterZeroIndex ? rb : rb + i);
+                sources[6 + i] = GetSrcReg(context, rc == RegisterConsts.RegisterZeroIndex ? rc : rc + i);
+            }
+
+            Operand d0 = Local(), d1 = Local();
+
+            context.Add(new Operation(Instruction.MatrixMultiplyAdd, 3, [d0, d1], sources));
+
+            context.Copy(GetDest(rd), d0);
+            context.Copy(GetDest(rd + 1), d1);
+        }
+
