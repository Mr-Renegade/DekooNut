diff --git a/src/Spv.Generator/CooperativeMatrixKhr.cs b/src/Spv.Generator/CooperativeMatrixKhr.cs
new file mode 100644
index 0000000..4c8da6f
--- /dev/null
+++ b/src/Spv.Generator/CooperativeMatrixKhr.cs
@@ -0,0 +1,56 @@
+using static Spv.Specification;
+
+namespace Spv.Generator
+{
+    // SPV_KHR_cooperative_matrix, which this generator's grammar predates (it has only the NV extension's opcodes):
+    // the type and the multiply-add, by their opcode numbers in the SPIR-V registry (ocarina-of-time-recomp, for the
+    // lowered SM86 HMMA).
+    public partial class Module
+    {
+        private const Op OpTypeCooperativeMatrixKHR = (Op)4456;
+        private const Op OpCooperativeMatrixMulAddKHR = (Op)4459;
+        private const Capability CapabilityCooperativeMatrixKHR = (Capability)6022;
+
+        // Declares the capabilities and the extension the two instructions below need, once per module.
+        public void UseCooperativeMatrixKhr()
+        {
+            if (!_capabilities.Contains(CapabilityCooperativeMatrixKHR))
+            {
+                _capabilities.Add(CapabilityCooperativeMatrixKHR);
+                _extensions.Add("SPV_KHR_cooperative_matrix");
+            }
+
+            if (!_capabilities.Contains(Capability.Float16))
+            {
+                _capabilities.Add(Capability.Float16);
+            }
+        }
+
+        // use: 0 MatrixA, 1 MatrixB, 2 MatrixAccumulator; scope, rows, columns and use are constant ids.
+        public Instruction TypeCooperativeMatrixKHR(Instruction componentType, Instruction scope, Instruction rows, Instruction columns, Instruction use)
+        {
+            Instruction result = NewInstruction(OpTypeCooperativeMatrixKHR);
+
+            result.AddOperand(componentType);
+            result.AddOperand(scope);
+            result.AddOperand(rows);
+            result.AddOperand(columns);
+            result.AddOperand(use);
+            AddTypeDeclaration(result, false);
+
+            return result;
+        }
+
+        public Instruction CooperativeMatrixMulAddKHR(Instruction resultType, Instruction a, Instruction b, Instruction c)
+        {
+            Instruction result = NewInstruction(OpCooperativeMatrixMulAddKHR, GetNewId(), resultType);
+
+            result.AddOperand(a);
+            result.AddOperand(b);
+            result.AddOperand(c);
+            AddToFunctionDefinitions(result);
+
+            return result;
+        }
+    }
+}
