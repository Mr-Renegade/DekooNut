+        // The high word of an address based on a bound buffer comes from that buffer's constant bank entry. A pointer read
+        // from memory has a high word with no constant buffer operand behind it, and a load on the way there.
+        private static bool AddressIsLoadedPointer(Operand high)
+        {
+            Queue<Operand> pending = new();
+            HashSet<Operand> seen = [];
+            bool load = false;
+            pending.Enqueue(high);
+            while (pending.TryDequeue(out Operand operand))
+            {
+                if (!seen.Add(operand))
+                {
+                    continue;
+                }
+                if (seen.Count > 4096)
+                {
+                    return true;
+                }
+                if (operand.Type == OperandType.ConstantBuffer)
+                {
+                    return false;
+                }
+                if (operand.AsgOp is PhiNode phi)
+                {
+                    for (int index = 0; index < phi.SourcesCount; index++)
+                    {
+                        pending.Enqueue(phi.GetSource(index));
+                    }
+                }
+                else if (operand.AsgOp is Operation definition)
+                {
+                    load |= definition.Inst == Instruction.Load;
+                    for (int index = 0; index < definition.SourcesCount; index++)
+                    {
+                        pending.Enqueue(definition.GetSource(index));
+                    }
+                }
+            }
+            return load;
+        }
