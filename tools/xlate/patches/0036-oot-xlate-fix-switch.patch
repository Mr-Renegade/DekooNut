diff --git a/src/Ryujinx.Graphics.Shader/Translation/XlateFix.cs b/src/Ryujinx.Graphics.Shader/Translation/XlateFix.cs
new file mode 100644
index 0000000..cd023a4
--- /dev/null
+++ b/src/Ryujinx.Graphics.Shader/Translation/XlateFix.cs
@@ -0,0 +1,58 @@
+using System;
+using System.Globalization;
+
+namespace Ryujinx.Graphics.Shader.Translation
+{
+    // OOT_XLATE_FIX: translator mismatches against Lichii (docs/XLATE-AUDIT.md "Fixes", docs/xlate-audit-A.md, -B.md),
+    // one bit each, all on by default. A set bit does what Lichii does. A job's "xlate_fix" (the runtime sends the mask
+    // its device supports) overrides the environment variable. Bit 0 lives in the Ampere lowering (runtime side).
+    public static class XlateFix
+    {
+        public const uint RedNegative = 1u << 0;       // A-M1, lower_to_maxwell.h (not read here)
+        public const uint ShadowRefExact = 1u << 1;    // B-M2, array depth compare reference not rounded to 16 bits
+        public const uint NoFmz = 1u << 2;             // B-M1, no FMZ experiment on FP32 multiply/FMA
+        public const uint FloatControls = 1u << 3;     // B-G1, SignedZeroInfNanPreserve 32
+        public const uint Demote = 1u << 4;            // B-M3, KIL demotes to a helper invocation
+        public const uint SwizzleAddSign = 1u << 5;    // B-M4, FSWZADD with Lichii's lookup tables
+        public const uint ArrayLayer16 = 1u << 6;      // B-M5, texture array layer = low 16 bits, unsigned
+        public const uint TmmlMask = 1u << 7;          // B-M6, TMML: S32 & 0xffff, U32 & 0xffff
+        public const uint I2fRz = 1u << 8;             // A-M2, I2F.F32.U32.RZ truncates
+        public const uint F2iClamp = 1u << 9;          // A-M3, F2I clamps in float, signed NaN -> 0
+        public const uint GlobalNegHigh = 1u << 10;    // A-M4, negative global offset borrows from the high word
+        public const uint All = (1u << 11) - 1;
+
+        private static readonly uint _env = Parse(Environment.GetEnvironmentVariable("OOT_XLATE_FIX"), All);
+
+        [ThreadStatic]
+        private static uint? _job;
+
+        public static uint Mask => _job ?? _env;
+
+        public static bool On(uint bit) => (Mask & bit) != 0;
+
+        public static void SetJob(uint? mask) => _job = mask;
+
+        // Discard (KIL) is a demote rather than a block end: IR side (ControlFlowGraph, BasicBlock) and SPIR-V side.
+        public static bool DiscardEnds => !On(Demote);
+
+        public static bool DemoteDiscard(ShaderStage stage) => stage == ShaderStage.Fragment && On(Demote);
+
+        // Decimal or 0x-hex; empty or unreadable gives the default.
+        public static uint Parse(string text, uint fallback)
+        {
+            if (string.IsNullOrWhiteSpace(text))
+            {
+                return fallback;
+            }
+
+            text = text.Trim();
+
+            if (text.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+            {
+                return uint.TryParse(text.AsSpan(2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out uint hex) ? hex & All : fallback;
+            }
+
+            return uint.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out uint dec) ? dec & All : fallback;
+        }
+    }
+}
